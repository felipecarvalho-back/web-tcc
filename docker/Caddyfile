{
    admin off
    frankenphp
    auto_https off
}

:{$PORT:10000} {
    root * /app/public
    encode zstd br gzip

    @static {
        path /build/*
        path *.ico *.svg *.png *.jpg *.jpeg *.webp *.woff *.woff2 *.ttf
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    php_server
}
